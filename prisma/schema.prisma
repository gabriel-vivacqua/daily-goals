// Daily Goals Tracker — data model
// See ../plan.md section 3 for the conceptual model. Completions are stored
// per (goal, date, subIndex) instead of materializing a row per day per goal;
// "today's goals" is derived from each Goal's recurrence rule on read.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase's "Transaction" pooler, port 6543) for the
  // app at runtime — serverless functions open/close connections constantly
  // and need pgbouncer in front of Postgres to avoid exhausting connections.
  url       = env("DATABASE_URL")
  // Session-mode pooler connection (port 5432, same pooler host as above)
  // used only for migrations — `prisma migrate` needs session-level
  // features (advisory locks) that the transaction pooler doesn't support.
  // Deliberately NOT Supabase's raw direct-connection host
  // (db.<ref>.supabase.co): that host is IPv6-only unless the project has
  // Supabase's paid IPv4 add-on, and most CI/build environments (Netlify,
  // Vercel, GitHub Actions) only have IPv4 egress — migrations would fail
  // to even reach the database there. The session pooler gives the same
  // session-level guarantees over an IPv4-reachable host.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // Embedded in the session JWT and checked on every request. Bumping this
  // invalidates every previously issued token for this user at once — the
  // only way to revoke a session before its JWT naturally expires, since
  // sessions are otherwise stateless.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  goals Goal[]

  @@map("users")
}

// Recurrence ("DAILY" | "WEEKDAYS" | "CUSTOM") is a plain string validated
// in application code (see src/lib/validation.ts) rather than a Prisma
// enum, to keep changing the allowed set a code-only change with no
// migration. A goal has no separate "type" — count=1 renders as a single
// checkbox, count>1 as N checkboxes.
model Goal {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  points     Float
  count      Int      @default(1)
  recurrence String   @default("DAILY")
  customDays String? // JSON array of ints, 0=Sunday..6=Saturday, used when recurrence=CUSTOM
  category   String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  completions Completion[]

  @@index([userId])
  @@map("goals")
}

model Completion {
  id          String   @id @default(cuid())
  goalId      String
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  date        String // "YYYY-MM-DD"
  subIndex    Int // 0-based index into the goal's sub-checks
  completedAt DateTime @default(now())

  @@unique([goalId, date, subIndex])
  @@index([goalId, date])
  @@map("completions")
}
