# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

# --- Database (Supabase Postgres) ---------------------------------------
# From your Supabase project: Project Settings -> Database -> Connection string.
#
# DATABASE_URL = the "Transaction" pooler connection (port 6543, pgbouncer).
#   Used by the app at runtime — serverless functions open/close connections
#   constantly and need the pooler to avoid exhausting Postgres connections.
#   Append ?pgbouncer=true to the URL.
# DIRECT_URL   = the direct connection (port 5432, no pooler).
#   Used only for running migrations (`prisma migrate deploy`), which need
#   session-level features the transaction pooler doesn't support.
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Auth -----------------------------------------------------------------
# Secret used to sign session cookies (JWT/HS256). Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be different from the dev default, and different per environment.
SESSION_SECRET="generate-a-real-random-secret"

# Shared code required to create a new account. Anyone deploying this app
# publicly should set this so strangers can't self-register. Generate one
# with: node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
INVITE_CODE="generate-a-real-invite-code"
